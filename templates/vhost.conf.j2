{{ ansible_managed | comment }}
{% set mode = item.mode | default('proxy') %}
{% set tls = item.tls | default(true) %}
{% macro proxy_location(path, cfg) %}
    location {{ path }} {
        proxy_pass {{ cfg.upstream }};
{% if cfg.preserve_host | default(true) %}
        proxy_set_header Host $host;
{% endif %}
{% for header, value in nginx_proxy_set_headers.items() %}
        proxy_set_header {{ header }} {{ value }};
{% endfor %}
{% if cfg.upstream is match('https:') %}
        proxy_ssl_server_name on;
{% endif %}
{% if cfg.websocket | default(false) %}
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% endif %}
{% if cfg.proxy_read_timeout is defined %}
        proxy_read_timeout {{ cfg.proxy_read_timeout }}s;
        proxy_send_timeout {{ cfg.proxy_read_timeout }}s;
{% endif %}
{% if cfg.extra is defined %}
{{ cfg.extra | indent(8, true) }}
{% endif %}
    }
{% endmacro %}
server {
{% if tls %}
{% set http2_directive = nginx_http2 and nginx_installed_version is version('1.25.1', '>=') %}
{% set http2_listen = ' http2' if (nginx_http2 and not http2_directive) else '' %}
    listen 443 ssl{{ http2_listen }};
    listen [::]:443 ssl{{ http2_listen }};
{% if http2_directive %}
    http2 on;
{% endif %}
{% else %}
    listen 80;
    listen [::]:80;
{% endif %}
    server_name {{ ([item.name] + (item.aliases | default([]))) | join(' ') }};
{% if tls %}

    ssl_certificate     {{ item.tls_certificate | default(nginx_tls_certificate) }};
    ssl_certificate_key {{ item.tls_certificate_key | default(nginx_tls_certificate_key) }};
    ssl_protocols       {{ nginx_ssl_protocols }};
{% if nginx_ssl_ciphers | length > 0 %}
    ssl_ciphers         {{ nginx_ssl_ciphers }};
{% endif %}
{% endif %}
{% if nginx_robots_enabled and item.robots | default(true) %}

    include snippets/robots.conf;
{% endif %}
{% if nginx_default_security_headers | length > 0 and item.security_headers | default(true) %}

{% for header in nginx_default_security_headers %}
    add_header {{ header }} always;
{% endfor %}
{% endif %}

    # AN-23: dotfiles (.env, .git*, .htaccess, an accidentally-shipped
    # .gitignore, ...) must never be served from a docroot. /.well-known/ is
    # explicitly excluded: ACME's own webroot carve-out is a separate
    # catch-all on :80 (http-redirect.conf.j2) so this exclusion isn't what
    # keeps certbot renewals working, but other /.well-known/ URIs (e.g.
    # security.txt) are legitimate and should keep resolving over :443 too.
    location ~ /\.(?!well-known/) {
        deny all;
        return 404;
    }
{% for location in item.locations | default([]) %}

{% if location.upstream is defined %}
{{ proxy_location(location.path, location) -}}
{% elif location.return is defined %}
    location {{ location.path }} {
        return {{ location.return }};
    }
{% elif location.root is defined %}
    location {{ location.path }} {
        root {{ location.root }};
    }
{% endif %}
{% endfor %}
{% if mode == 'proxy' and item.upstream is defined %}

{{ proxy_location('/', item) -}}
{% elif mode == 'static' %}

    root {{ item.root }};
    index {{ item.index | default('index.html index.htm') }};

    location / {
        try_files $uri $uri/ =404;
    }
{% elif mode == 'redirect' %}

    return {{ item.redirect_code | default(301) }} {{ item.redirect_to }}{{ '$request_uri' if item.redirect_preserve_path | default(true) else '' }};
{% elif mode == 'php' %}

    root {{ item.root }};
    index {{ item.index | default('index.php index.html') }};

{% for pattern in item.php_deny | default([]) %}
    location ~ {{ pattern }} {
        deny all;
    }
{% endfor %}
    location / {
{% if item.php_front_controller is defined %}
        try_files $uri $uri/ {{ item.php_front_controller }}$is_args$args;
{% else %}
        try_files $uri $uri/ =404;
{% endif %}
    }

    location ~ [^/]\.php(/|$) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        try_files $fastcgi_script_name =404;
        fastcgi_pass {{ item.php_fpm_pass | default(nginx_php_fpm_pass) }};
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }
{% endif %}
{% if item.extra_config is defined %}

{{ item.extra_config | indent(4, true) }}
{% endif %}
}
